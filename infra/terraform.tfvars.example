# Copy to terraform.tfvars and customize

aws_region  = "us-east-1"
environment = "prod"

# GitHub repo for brief content (owner/repo format)
content_repo = "j0nathanb/pdb-aggregator"

# Set to true to enable the Sunday 9 PM ET cron schedule
enable_schedules = false

# VPC settings (defaults are fine for most cases)
# vpc_cidr           = "10.0.0.0/24"
# public_subnet_cidr = "10.0.0.0/26"
# availability_zone  = "us-east-1a"
