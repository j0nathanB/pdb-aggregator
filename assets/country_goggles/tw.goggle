! name: MPM Taiwan
! description: MPM pipeline source prioritization for Taiwan — boosts high-signal sources, discards noise
! public: false
! author: MPM Pipeline

! --- Tier 1: Essential (boost=10) ---
$boost=10,site=focustaiwan.tw
$boost=10,site=ltn.com.tw
$boost=10,site=taipeitimes.com
$boost=10,site=udn.com
$boost=10,site=cw.com.tw

! --- Tier 2: Important (boost=5) ---
$boost=5,site=indsr.org.tw
$boost=5,site=pf.org.tw
