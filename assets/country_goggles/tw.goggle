$boost=5,site=storm.mg
$boost=5,site=twreporter.org
$boost=5,site=mofa.gov.tw
$boost=5,site=mnd.gov.tw
$boost=5,site=president.gov.tw
$boost=5,site=ey.gov.tw

! --- Tier 3: Supplementary (boost=3) ---
